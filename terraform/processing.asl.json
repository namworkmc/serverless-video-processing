{
  "Comment": "Processing leg (Story 2.2, AD-4): status-first ordering is structural. UPLOADED -> PROCESSING -> PROCESSED via direct DynamoDB integrations, transcode worker in between, terminal video.processed published last. Condition pairs mirror lambdas/_shared/status.py LEGAL_TRANSITIONS exactly. LAMBDA INVOKE SHAPE: floci >= 1.7.0 wraps the Lambda result as {Payload: ..., StatusCode: ...} like real AWS (1.6.0 returned it directly) — the Transcode task unwraps $.Payload via ResultSelector so the ASL is identical on floci and real AWS.",
  "StartAt": "MarkProcessing",
  "States": {
    "MarkProcessing": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${table_name}",
        "Key": {
          "videoId": { "S.$": "$.videoId" }
        },
        "UpdateExpression": "SET #s = :next, updatedAt = :updatedAt",
        "ConditionExpression": "#s = :expected",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": {
          ":expected": { "S": "UPLOADED" },
          ":next": { "S": "PROCESSING" },
          ":updatedAt": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": null,
      "Next": "Transcode"
    },
    "Transcode": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${transcode_arn}",
        "Payload": {
          "videoId.$": "$.videoId",
          "originalKey.$": "$.key"
        }
      },
      "ResultSelector": {
        "videoId.$": "$.Payload.videoId",
        "originalKey.$": "$.Payload.originalKey",
        "processedKey.$": "$.Payload.processedKey",
        "sizeBytes.$": "$.Payload.sizeBytes"
      },
      "ResultPath": "$",
      "Next": "MarkProcessed"
    },
    "MarkProcessed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${table_name}",
        "Key": {
          "videoId": { "S.$": "$.videoId" }
        },
        "UpdateExpression": "SET #s = :next, updatedAt = :updatedAt, processedKey = :pk",
        "ConditionExpression": "#s = :expected",
        "ExpressionAttributeNames": { "#s": "status" },
        "ExpressionAttributeValues": {
          ":expected": { "S": "PROCESSING" },
          ":next": { "S": "PROCESSED" },
          ":updatedAt": { "S.$": "$$.State.EnteredTime" },
          ":pk": { "S.$": "$.processedKey" }
        }
      },
      "ResultPath": null,
      "Next": "PublishProcessed"
    },
    "PublishProcessed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${publisher_arn}",
        "Payload.$": "$"
      },
      "End": true
    }
  }
}
